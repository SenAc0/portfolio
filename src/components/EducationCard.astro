---
const {name, date_start, date_end, title } = Astro.props;

const date_end_true = date_end ? date_end : 'Presente';
---
<!-- Recibe props de una educacion y presenta en formato de tarjeta -->
<div class="flex">
    
    <div class="w-px h-32 bg-black mx-8"></div>

    <div class="content" style="flex: 1;">
        <p class="role" style="font-size: 1.25rem; font-weight: bold; color: #003966;">{title}</p>

        <div class="flex justify-between mb-2 gap-8">

            <p class="institution" style="font-size: 1.10rem; font-weight: bold;">{name}</p>
            <p class="date" style="font-size: 1.10rem; font-weight: bold;">{date_start} - {date_end_true}</p>    

        </div>


    </div> 
      
</div>
