---
import { getCollection } from 'astro:content';

import Button from './Button.astro';

const me_data = await getCollection('me');
const me = me_data[0]
---
<section class="min-h-screen relative flex items-center ">

    <div class="image-container absolute inset-0">
        <img
            src="water-2.svg"
            class="w-full h-full object-cover pointer-events-none select-none"
            alt=""
            draggable="false"
        >
    </div>

    <div class="absolute text-left pl-16">
        <h1 class="text-4xl md:text-6xl font-bold text-white">
            Hola, soy {me.data.name} 
        </h1>

 


        <div class="mt-6 flex items-center gap-4">
            <a
                href={me.data.social.linkedin.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
                title="LinkedIn"
            >
                <img src="/linkedin.svg" alt="" class="w-7 h-7">
            </a>
            <a
                href={me.data.social.github.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub"
                title="GitHub"
            >
                <img src="/github.svg" alt="" class="w-7 h-7">
            </a>
            <div class="">
                <Button text="Ver CV" />
            </div>
        </div>
    </div>

</section>


