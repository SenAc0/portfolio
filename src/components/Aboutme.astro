---
import {getCollection} from 'astro:content';
const aboutme = await  getCollection('aboutme');
const about = aboutme[0];
---

<section id="aboutme" class="mb-8">
		<div class="title px-40" style = "display: flex; flex-direction: column; align-items: left; margin-top: 2rem;">
			<h1 style = "font-size: 2rem; font-weight: bold;">Sobre mí</h1>
		</div>
		
		<section class="about px-40 py-1 " style = "display: flex; flex-direction: column; align-items: left; margin-top: 2rem;">
            <h1 class="text-lg text-justify ">
				{about.data.es.description}
			</h1>
		</section>

</section>


