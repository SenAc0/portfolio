---
import ProjectCard from './ProjectCard.astro';
import { useTranslations, toLang } from '../i18n/ui';
import { getProjects, projectSlug, type Project } from '../utils/projects';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);

const projects = await getProjects(lang);
---

<section id="projects" class="content-section">
		<div class="section-title">
			<h1>{t('section.projects')}</h1>
		</div>
		<div class="section-content section-content-centered">
			<div class="grid gap-6 grid-cols-1">

				{projects.map((project: Project, index: number) => (
				<ProjectCard
					title={project.data.title}
					year={project.data.year}
					description={project.data.description_brief}
					orientation={index % 2 === 0}
					slug={projectSlug(project)}
					image_logo={project.data.logo}
				/>
			))}

			</div>
		</div>
</section>
