---
import { getCollection, type CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const projects = await getCollection( 'projects' );


---

<section id="projects" class="content-section">
		<div class="section-title">
			<h1>Proyectos</h1>
		</div>
		<div class="section-content section-content-centered">
			<div class="grid gap-6 grid-cols-1">

				{projects.map((project: CollectionEntry<'projects'>, index: number) => (
				<ProjectCard
					title={project.data.es.title}
					year={project.data.year}
					description={project.data.es.description}
					orientation={index % 2 === 0}
					slug={project.id}
					image_logo={project.data.images.logo}
				/>
			))}

			</div>
		</div>
</section>

