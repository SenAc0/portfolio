---
import { render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, toLang } from '../i18n/ui';
import type { Project } from '../utils/projects';

interface Props {
    project: Project;
}

const { project } = Astro.props;

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);

// El cuerpo del Markdown es la descripción larga, ya convertida a HTML por Astro.
const { Content } = await render(project);

// Vuelve al listado de proyectos del mismo idioma: '/#projects' o '/en/#projects'.
const backHref = `${getRelativeLocaleUrl(lang, '')}#projects`;
---
<!-- Detalle de un proyecto: recibe la entrada de la colección y la muestra completa -->
<section class="content-section">
    <div class="section-title">
        <a href={backHref} class="text-[#003966] font-bold hover:underline">{t('project.back')}</a>
    </div>

    <div class="section-content">
        <img
            src={project.data.logo}
            alt={project.data.title}
            style="max-width: 100%; max-height: 120px; width: auto; height: auto; border-radius: 4px; margin-bottom: 1.5rem;"
        />

        <h1 style="margin: 0; font-size: 2rem; font-weight: 700;">{project.data.title}</h1>

        <p style="font-size: 1.20rem; font-weight: bold; color: #003966;">{project.data.year}</p>

        <div class="markdown-content">
            <Content />
        </div>
    </div>
</section>
