---
import { extractDate, MonthNumberToString } from '../utils/date.js';

const { date_start, date_end, company, role, description } = Astro.props;

// get month and year from date_start and date_end, and convert month number to string
const date_start_parsed = extractDate(date_start);

const month_start = MonthNumberToString(date_start_parsed.month);



const date_end_parsed = date_end ? extractDate(date_end) : null;

const date_end_true = date_end_parsed ? `${MonthNumberToString(date_end_parsed.month).es}/${date_end_parsed.year}` : 'Presente';


---
<!-- Recibe props de una experiencia y presenta en formato de tarjeta -->
<div class="flex">
    
    <div class="w-px h-32 bg-black mx-8"></div>

    <div class="content" style="flex: 1;">
        <p class="role" style="font-size: 1.25rem; font-weight: bold; color: #003966;">{role}</p>

        <div class="flex justify-between mb-2 gap-8">

            <p class="company" style="font-size: 1.10rem; font-weight: bold;">{company}</p>
            <p class="date" style="font-size: 1.10rem; font-weight: bold;">{month_start.es}/{date_start_parsed.year} - {date_end_true}</p>    

        </div>
    
        <p class="description" style="font-size: 1rem; font-weight: normal; justify-content: justify; text-align: justify;">{description}</p>
    </div>
</div>
