---
import { getCollection, type CollectionEntry } from 'astro:content';
import ExperienceCard from './ExperienceCard.astro';


const experiences = await getCollection( 'experience' );



---
<section id="experience" class="content-section">
		<div class="section-title">
			<h1>Experiencia</h1>
		</div>
		<div class="section-content section-content-centered">
			<div class = "grid grid-cols-1">

				{experiences.map((exp: CollectionEntry<'experience'>) => (
				<ExperienceCard
					date_start={exp.data.date_start}
					date_end={exp.data.date_end}
					company={exp.data.company}
					role={exp.data.es.role}
					description={exp.data.es.description}
				/>
			))}


			</div>
		</div>
</section>

