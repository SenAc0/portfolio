---
import { getCollection } from 'astro:content';
import { useTranslations, toLang } from '../i18n/ui';

const me_raw = await getCollection('me');
const me = me_raw[0];

const t = useTranslations(toLang(Astro.currentLocale));
---



<footer class="footer" style="display: flex; justify-content: center; align-items: center; padding: 1rem">
  <p style="margin: 0;">&copy; 2026 {me.data.name}. {t('footer.license')}</p>
</footer>