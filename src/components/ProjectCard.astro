---
import Button from './Button.astro';
import { useTranslations, toLang } from '../i18n/ui';

const { title, year, description, orientation, slug, image_logo } = Astro.props;

const t = useTranslations(toLang(Astro.currentLocale));
---
<!-- Recibe props de un proyecto y presenta en formato de tarjeta -->
<div class={`flex flex-col ${orientation ? "sm:flex-row-reverse" : "sm:flex-row"} w-full max-w-[800px] p-4 sm:p-16`}>

    <div class="image-container mb-4 sm:mb-0 sm:flex-[0_0_200px]">
        <img src={image_logo} alt={title} style="max-width: 100%; max-height: 100px; width: auto; height: auto; border-radius: 4px;" />
    </div>

    <div class="content flex-1 min-w-0 sm:mx-4">
        <h2 class="project name" style="font-size: 1.25rem; font-weight: bold;">{title}</h2>
        
        <p class="year" style="font-size: 1.20rem; font-weight: bold; color: #003966;">{year}</p>
        
        <p class="description" style="font-size: 1rem; font-weight: normal; margin-bottom: 32px;">{description}</p>

        <div class={orientation ? "flex-row-reverse" : "flex-row"} style="display: flex; justify-content: flex-end;">
            <Button  text={t('card.more')} slug={slug}/>

        </div>
        
    </div>
</div>