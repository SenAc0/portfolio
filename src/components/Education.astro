---
import { getCollection, type CollectionEntry } from 'astro:content';
import EducationCard from './EducationCard.astro';

const education = await getCollection( 'education' );





---

<section id="education" class="content-section">
		<div class="section-title">
			<h1>Educación</h1>
		</div>
		<div class="section-content section-content-centered">
			<div class = "grid grid-cols-1">

				{education.map((edu: CollectionEntry<'education'>) => (

                    <EducationCard 
                        name={edu.data.name}
                        date_start={edu.data.date_start}
                        date_end={edu.data.date_end}
                        title={edu.data.es.title}
                    />
                ))}


			</div>
		</div>
</section>

